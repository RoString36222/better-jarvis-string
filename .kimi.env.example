# Copy to .kimi.env (git-ignored) and fill in. Never commit the real file.
# Any Anthropic-compatible gateway works; these are placeholders.
export ANTHROPIC_BASE_URL="https://your-gateway.example.com"
export ANTHROPIC_AUTH_TOKEN="your-token-here"
export ANTHROPIC_MODEL="kimi-latest"
export ANTHROPIC_SMALL_FAST_MODEL="your-fast-model"
export CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1

# Optional: real web search instead of the Wikipedia fallback (pick one).
# export SERPER_API_KEY="..."
# export BRAVE_SEARCH_API_KEY="..."
