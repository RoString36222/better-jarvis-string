# ZEN settings — copy to .kimi.env (git-ignored) and fill in what you use.
# Never commit the real .kimi.env. Everything here is optional.

# --- The brain ----------------------------------------------------------------
# Leave these three out to run on your Claude Code login (run `claude` once).
# Or point ZEN at any Anthropic-compatible gateway (e.g. an org-hosted Kimi):
# export ANTHROPIC_BASE_URL="https://your-gateway.example.com"
# export ANTHROPIC_AUTH_TOKEN="your-token-here"
# export ANTHROPIC_MODEL="kimi-latest"
# export ANTHROPIC_SMALL_FAST_MODEL="your-fast-model"
# export CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1   # needed for most non-Anthropic gateways

# --- Spotify (see README → Spotify) -------------------------------------------
# Your app's Client ID from developer.spotify.com. Public, not a secret.
# export SPOTIFY_CLIENT_ID="your-client-id"

# --- Search -------------------------------------------------------------------
# Real web search for research walls (otherwise Wikipedia). Pick one:
# export SERPER_API_KEY="..."
# export BRAVE_SEARCH_API_KEY="..."

# --- Optional tweaks ------------------------------------------------------------
# export STRING_HOME_CITY="Bengaluru"     # default city for weather
# export ZEN_HOTKEY="Alt+Space"           # desktop app summon key
# export ZEN_DEFAULT_PLAYLIST="spotify:playlist:37i9dQZF1DXcBWIGoYBM5M"
